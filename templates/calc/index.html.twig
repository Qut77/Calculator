{% extends 'base.html.twig' %}

{% block title %}Calculator{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow" style="width: 350px;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Калькулятор</h3>

            <form method="POST" action ="{{ path('app_calc') }}">
                <div class="mb-3">
                    <label class="form-label">Первое число</label>
                    <input type="number" class="form-control" name="number1">
                </div>

                <div class="mb-3">
                    <label class="form-label">Операция</label>
                    <select class="form-select" name="operation">
                        <option value="add">+</option>
                        <option value="subtract">−</option>
                        <option value="multiply">×</option>
                        <option value="divide">÷</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Второе число</label>
                    <input type="number" class="form-control" name="number2">
                </div>

                <button type="submit" class="btn btn-primary w-100">Вычислить</button>
            </form>

            <div class="mt-4 text-center fs-4">
                Результат: <strong>{{ result ?? '—' }}</strong>
            </div>
        </div>
    </div>
</div>
{% endblock %}